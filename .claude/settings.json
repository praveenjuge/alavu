{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/cloud-session-start.sh",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bun install --frozen-lockfile)",
      "Bash(bun run check)",
      "Bash(bun run lint)",
      "Bash(bun run format)",
      "Bash(bun run typecheck)",
      "Bash(bun run test)",
      "Bash(bun run test *)",
      "Bash(bun run e2e)",
      "Bash(bun run dev)",
      "Bash(bun run build)",
      "Bash(bunx vitest *)",
      "Bash(bunx biome check *)",
      "Bash(bunx tsc *)",
      "Bash(node e2e/smoke.mjs)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(bunx convex deploy *)",
      "Bash(bunx convex deploy)",
      "Bash(bunx convex env *)",
      "Bash(bunx convex run *)",
      "Bash(bunx convex import *)",
      "Bash(bunx cf deploy *)",
      "Bash(bunx cf deploy)",
      "Bash(bun run deploy)",
      "Bash(bundle exec fastlane *)"
    ]
  }
}
